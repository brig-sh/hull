#syntax=harbor.nbfc.io/nubificus/bunny:latest

FROM ubuntu:latest

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    linux-image-generic \
    procps \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create init script with proper mounts
RUN echo '#!/bin/bash' > /init && \
    echo 'mount -t proc proc /proc' >> /init && \
    echo 'mount -t sysfs sysfs /sys' >> /init && \
    echo 'mount -t devtmpfs devtmpfs /dev 2>/dev/null || true' >> /init && \
    echo 'mount -t tmpfs tmpfs /tmp' >> /init && \
    echo 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' >> /init && \
    echo '' >> /init && \
    echo '# Try to mount 9pfs if available' >> /init && \
    echo 'if grep -q 9p /proc/filesystems 2>/dev/null; then' >> /init && \
    echo '  mkdir -p /mnt/host' >> /init && \
    echo '  mount -t 9p -o trans=virtio fs0 /mnt/host 2>/dev/null || true' >> /init && \
    echo 'fi' >> /init && \
    echo '' >> /init && \
    echo 'echo "=== Ubuntu Unikernel VM ===' >> /init && \
    echo 'echo "Kernel: $(uname -r)"' >> /init && \
    echo 'echo "Hostname: $(hostname)"' >> /init && \
    echo 'echo "Available filesystems:"' >> /init && \
    echo 'cat /proc/filesystems' >> /init && \
    echo 'echo "=== Launching interactive shell ===' >> /init && \
    echo 'exec /bin/bash' >> /init && \
    chmod +x /init

# Configure kernel parameters
LABEL com.urunc.unikernel.kernel="/.boot/kernel"
LABEL com.urunc.unikernel.hypervisor="qemu"
LABEL com.urunc.unikernel.unikernelType="linux"
LABEL com.urunc.unikernel.cmdline="root=/dev/ram0 init=/init console=ttyS0"

ENTRYPOINT ["/init"]
