# The hvi release hull ships, read by scripts/fetch-hvi.sh.
#
# The script downloads this tag from brig-sh/hvi-vmm and checks that
# SHA256SUMS is signed by hvi's tag-release workflow for the tag. The archive
# must then have the sha below, and its manifest the commit below. The three
# lines describe one release, so a bump changes all three together.
HVI_VERSION=0.1.0-rc.2
HVI_COMMIT=2ed8f61
HVI_SHA256_AARCH64_APPLE_DARWIN=33785ef0702cfada99dd1b6e75190ae35a87c00d84a44e27b07d17fc0e5fc32e
